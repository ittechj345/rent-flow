# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # SECRET. Server only. Never put NEXT_PUBLIC_ in front of it.

# Protects the daily cron endpoint. Any long random string. Vercel sends it automatically.
CRON_SECRET=change-me-to-a-long-random-string

# Optional: lets the agent write the daily summary and classify messy repair requests.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5
